# 올릴 것만 허용하는 방식: 처음에 전부 막고, 필요한 것만 연다.
# 한국데이터(DataGuide 원본)·processed(가공 데이터)·참고 논문(저작권 PDF)은 절대 올리지 않는다.
/*
!/.gitignore
!/README.md

# 팀 문서: docs 안의 .md만
!/docs/
/docs/*
!/docs/*.md

# 코드: scripts 안의 .py만
!/scripts/
/scripts/*
!/scripts/*.py

# 예전 작업 코드는 올리지 않는다.
/scripts/01_cache_raw.py
/scripts/02_parse_korea.py
/scripts/02b_상폐수익률.py
/scripts/04_merge_korea.py
/scripts/korea_parsers.py
/scripts/모멘텀팩터(WML) 재현.py
/scripts/팩터공통.py

# 결과: 그림만 (csv는 데이터 값이 들어 있어 뺌)
!/결과/
/결과/**
!/결과/**/
!/결과/**/*.png

# 예전 작업 그림은 올리지 않는다.
/결과/모멘텀팩터(WML)/

# 개인 키·비밀 파일 (혹시 생겨도 막기)
*키*.txt
*.env
